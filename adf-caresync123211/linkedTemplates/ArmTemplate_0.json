		{
			"name": "[concat(parameters('factoryName'), '/PL_EMAIL_DEMO')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Send_Email",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "Prepare Email Body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": "https://prod-14.northcentralus.logic.azure.com:443/workflows/4f3d42df8d504d5c8234a5b39df1aac5/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=VfBfJ92pFpDSzb2lgT844yvdYC9JhaHFN3FvQbPW59E",
							"body": {
								"value": "@variables('logicapps_body')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Prepare Email Body",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Prepare email subject",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Prepare_Email_Body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "logicapps_body",
							"value": {
								"value": "{\"email_recipient\":\"@{pipeline().parameters.email_recipient}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"body\":\"@{variables('email_body')}\"\n}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Prepare email subject",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_subject",
							"value": {
								"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Prepare_Email_Body",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_body",
							"value": {
								"value": "The table @{pipeline().parameters.table_name} ingestion has been completed. and the status is @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"email_recipient": {
						"type": "string"
					}
				},
				"variables": {
					"logicapps_body": {
						"type": "String"
					},
					"email_subject": {
						"type": "String"
					},
					"email_body": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": []
