							"body": {
								"value": "@variables('logicapps_body')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Prepare Email Body",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Prepare email subject",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Prepare_Email_Body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "logicapps_body",
							"value": {
								"value": "{\"email_recipient\":\"@{pipeline().parameters.email_recipient}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"body\":\"@{variables('email_body')}\"\n}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Prepare email subject",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_subject",
							"value": {
								"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Prepare_Email_Body",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_body",
							"value": {
								"value": "The table @{pipeline().parameters.table_name} ingestion has been completed. and the status is @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"email_recipient": {
