{
	"name": "PL_FOREACH_DEMO",
	"properties": {
		"activities": [
			{
				"name": "Ingest All tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read List of Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read List of Tables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute Ingestion Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_ADFCourseDemo_Ingestion",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Store Table Successs",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Ingestion Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": "@item().table_name - Success"
							}
						},
						{
							"name": "Store Table failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Ingestion Pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@item().table_name - Failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Read List of Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select table_name from metadata.table_list",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_ADFCourse",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"tablename": "customers"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Send consolidated Email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Ingest All tables",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EMAIL_DEMO_MULTIPLE",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email_recipient": {
							"value": "@pipeline().globalParameters.email_recipient",
							"type": "Expression"
						},
						"table_status": {
							"value": "@variables('table_status')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"variables": {
			"table_status": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}